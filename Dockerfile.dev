# Step 1: Use an official Node.js runtime as the base image
FROM node:24-alpine

# Step 2: Set the working directory inside the container to the workspace root
WORKDIR /app

# Step 3: Copy workspace configurations and package files first to leverage Docker cache
COPY package*.json pnpm-lock.yaml* pnpm-workspace.yaml* ./



# Explicitly create and target the specific project directories
COPY ecommerce-admin/package.json ./ecommerce-admin/package.json
COPY ecommerce-customer/package.json ./ecommerce-customer/package.json

# Enable corepack to use pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Step 4: Install dependencies globally across the workspace using the cache mount
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store pnpm install --no-frozen-lockfile

# Step 5: Copy the rest of your application code across both modules
COPY . .

# Step 6: Expose the ports both applications will run on
EXPOSE 3000
EXPOSE 3001

ENV WATCHPACK_POLLING=true

# Step 7: Boot up both development servers concurrently using pnpm workspace filter
#CMD ["pnpm", "--filter", "*", "run", "dev"]
# Replace the old step 7 with a generic default command
CMD ["pnpm", "run", "dev"]

